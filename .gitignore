.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
.env
.env.*
!.env.local.example
!**/.env.local.example

# Node / frontend
node_modules/
.next/
out/
.sst/
.open-next/
sst-env.d.ts

# IDE
.idea/
.vscode/
*.swp

# Secrets and per-device drone files (never commit)
drone/common/config.yaml
drone/common/config.stack-dev.yaml
drone/common/certs/*.pem
drone/common/certs/*.key
drone/common/certs/*.crt
drone/common/certs/thing-name.txt
**/claim-private.key
.drone-id

# Large / generated model weights
*.gguf
*.onnx
*.onnx.data
*.pt
*.pth
*.npy
*.engine
*.trt
*.bin
drone/models/*
!drone/models/.gitignore

# ...except the 3 policy files the presidioautonomy.com homepage sim commits and serves directly
# (avoids a runtime cross-origin fetch from HF and version-locks the browser's state/action
# contract to the exact deployed weights — see eco/www/src/lib/sim/).
!www/public/models/policy_v26rnn_dr.onnx
!www/public/models/policy_rover_v2.onnx
!www/public/models/policy_rover_v2.onnx.data
!drone/models/README.md
!drone/models/setup_models.py

# Logs and local state
*.log
drone/common/logs/

# iOS / Xcode
**/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# macOS
.AppleDouble

# Build artifacts
*.tsbuildinfo

# Local scratch
drone/.local/
www/test-sim.mjs
www/public/sim_video_test.html

# Large 3D source assets (downloaded via drone/sim/godot/setup_assets.py or tracked in LFS)
/assets/*.glb
drone/sim/godot/assets/*
# Kenney CC0 city kit (~500KB, CC0) is tracked directly
!drone/sim/godot/assets/kenney_city

# research media (large; demo reel is on YouTube)
papers/videos/
papers/*.mp4
www/public/media/L5_demo_reel.mp4
www/public/media/L5_demo_reel_poster.jpg
drone/training/policy_ma_rover_v2.onnx.data
drone/training/policy_ma_rover_v2_state_norm.npy
drone/training/hetero_v1/
drone/training/videos_hetero_v2/

# e2e run artifacts (regenerated by run_e2e.py; CI uploads scorecards as workflow
# artifacts instead of committing them)
e2e/scorecard.json
e2e/_sim_validate_report.json

# VLM perception-gate captures (drone/sim/fw_gate_vlm.py). The report.json beside
# them IS committed — it is the evidence for the M1 gate decision — but the raw
# frames are bulky and fully regenerable by re-running the harness.
drone/sim/gate_out/frames/
drone/sim/gate_out_*/frames/
# Recorded demo takes: thousands of JPEGs per take, regenerable from a seed.
drone/sim/takes/

# Experiment render output — large, regenerable, and not referenced by any code
# or docs. Stripped from history; keep them out. (videos_phrover/ is NOT ignored:
# rover/sim/*.py writes to it and rover/docs references it.)
videos_hetero_v1/
videos_hetero_v2/
videos_decomposed/

# Xcode device build output (956 MB of artifacts, never a source input).
client/ios/DroneOperator/build_device/
