# Copy this to .env.local for local/offline demo mode.
# Do NOT commit .env.local — it is gitignored by Next.js.
# These vars are absent in production (AWS), so AWS behavior is unchanged.

# Swap YouTube embed → local video player, and Bedrock → Ollama
OFFLINE_MODE=true
NEXT_PUBLIC_OFFLINE_MODE=true

# Ollama model to use (must be pulled: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
