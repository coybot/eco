# Copy to ~/.config/coybot/secrets.env and fill in, then `chmod 600` it.
# (~/.config/coybot/secrets.env is used as a fallback, so one file can
# serve both this checkout and coybot-autonomy/eco.)
#
# These endpoints embed the AWS account they belong to, so this repository
# tracks placeholders instead of real values. The sim launchers source this
# file (drone/sim/secrets_env.sh) and the Python entrypoints read it
# (drone/sim/endpoints.py). An explicit command-line flag, or a variable you
# have already exported, always wins over what is set here.
#
# Look them up with:
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS
#   aws iot describe-endpoint --endpoint-type iot:CredentialProvider

IOT_ENDPOINT=YOUR_IOT_ENDPOINT.iot.us-west-2.amazonaws.com
CREDENTIALS_ENDPOINT=YOUR_CREDENTIALS_ENDPOINT.credentials.iot.us-west-2.amazonaws.com
