[Unit]
# Godot sim, fullscreen on thor's own monitor.
#
# A USER unit, not a system service, because this renders to a real display: it
# needs the seat's X session, its DISPLAY and its Xauthority, none of which exist
# for a system unit. A system unit would have to invent a virtual display, and
# then nothing appears on the monitor at all, which is the opposite of the point.
#
# Deliberately NOT WantedBy=graphical-session.target, which is the obvious thing
# and does not work here: on this box GNOME does not drive the systemd --user
# targets, so `systemctl --user is-active graphical-session.target` reports
# inactive even with a live desktop session. A unit hung off it is enabled, never
# starts, and leaves no journal entries at all — which is exactly how this failed
# after one reboot.
#
# DISPLAY is discovered by run-sim.sh, not set here. Hardcoding it is what broke
# this the second time: the number moved from :1 to :0 when autologin was enabled
# (no greeter session to hold :0 any more) and the unit retried for four hours
# against a socket that was never going to appear. Same empty screen, different
# cause. See run-sim.sh.
Description=Coybot Manhattan sim (fullscreen)
After=default.target

[Service]
Type=simple
ExecStart=/home/<user>/eco/drone/sim/deploy/run-sim.sh
Restart=always
# 30 s, not 5: while nobody is logged in this unit cannot possibly succeed, and a
# 5 s loop just fills the journal with identical failures.
RestartSec=30
TimeoutStartSec=60

[Install]
WantedBy=default.target
