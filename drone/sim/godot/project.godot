; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows editing it manually.

config_version=5

[application]

config/name="CoybotEcoSim"
config/description="Coybot drone fleet simulator — Godot 4 backend for eco/"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

IpcServer="*res://scripts/ipc_server.gd"
FleetManager="*res://scripts/fleet_manager.gd"
PhroverManager="*res://scripts/phrover_manager.gd"
FixedWingManager="*res://scripts/fixedwing_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.1, 0.1, 0.12, 1)

[shader_globals]

; the thermal band (shaders/thermal.gdshaderinc, scripts/thermal_kit.gd).
thermal_air_c={
"type": "float",
"value": 27.0
}
thermal_sea_c={
"type": "float",
"value": 27.5
}
thermal_store={
"type": "float",
"value": 0.5
}
thermal_cool={
"type": "float",
"value": 0.0
}
thermal_sun_gain={
"type": "float",
"value": 0.0
}
thermal_sky_c={
"type": "float",
"value": -3.0
}
thermal_lamps={
"type": "float",
"value": 0.0
}
