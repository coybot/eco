# ArduCopter 4.7.1 SITL defaults for flying the way the quadcopter does. Load after the
# build's own Tools/autotest/default_params/copter.parm:
#   arducopter --defaults <ardupilot>/Tools/autotest/default_params/copter.parm,<this file>
#
# Navigation, failsafe, fence, mode and RTL/land parameters as read from the quadcopter's
# Cube Orange (ArduCopter 4.7.1 dbe79216) on 2026-10-18. 4.7 renamed several (WP_SPD,
# RTL_ALT_M, ARMING_SKIPCHK; there is no ARMING_CHECK) - older SITL builds ignore them.
#
# The last four lines are SITL-only, not the aircraft's:
#   SIM_WIND_*        3 m/s gusty wind from 250 deg, so position hold is not unrealistically perfect
#   LOG_BACKEND_TYPE  0: SITL crashes (SIGILL) in the file logger on some builds
#   SIM_BATT_VOLTAGE  16.8: a full 4S pack, or drone_sdk's battery gate refuses takeoff
ARMING_NEED_LOC 0
ARMING_RUDDER 2
ARMING_SKIPCHK 2097144
AUTO_OPTIONS 0
DISARM_DELAY 30
EK3_SRC1_POSXY 3
EK3_SRC1_POSZ 1
EK3_SRC1_VELXY 3
EK3_SRC1_VELZ 3
EK3_SRC1_YAW 1
FENCE_ACTION 1
FENCE_ALT_MAX 100
FENCE_ALT_MAX_TP 1
FENCE_ALT_MIN -10
FENCE_ALT_MIN_TP 1
FENCE_AUTOENABLE 0
FENCE_ENABLE 0
FENCE_MARGIN 2
FENCE_MARGIN_XY 0
FENCE_NTF_FREQ 1
FENCE_OPTIONS 0
FENCE_RADIUS 300
FENCE_TOTAL 0
FENCE_TYPE 7
FLTMODE1 0
FLTMODE2 0
FLTMODE3 0
FLTMODE4 0
FLTMODE5 0
FLTMODE6 9
FLTMODE_CH 5
FLTMODE_GCSBLOCK 0
FRAME_CLASS 1
FRAME_TYPE 1
FS_CRASH_CHECK 1
FS_DR_ENABLE 2
FS_DR_TIMEOUT 30
FS_EKF_ACTION 1
FS_EKF_FILT 5
FS_EKF_THRESH 0.8
FS_GCS_ENABLE 0
FS_GCS_TIMEOUT 5
FS_OPTIONS 16
FS_THR_ENABLE 0
FS_VIBE_ENABLE 1
GUID_OPTIONS 0
GUID_TIMEOUT 3
LAND_ALT_LOW_M 10
LAND_REPOSITION 1
LAND_SPD_HIGH_MS 0
LAND_SPD_MS 0.5
LOIT_ACC_MAX_M 5
LOIT_ANG_MAX 0
LOIT_BRK_ACC_M 2.5
LOIT_BRK_DELAY 1
LOIT_BRK_JRK_M 5
LOIT_OPTIONS 1
LOIT_SPEED_MS 12.5
PILOT_ACC_Z 2.5
PILOT_SPD_DN 0
PILOT_SPD_UP 2.5
PILOT_THR_BHV 0
PILOT_THR_FILT 0
PILOT_TKO_ALT_M 0
PILOT_Y_EXPO 0
PILOT_Y_RATE 202.5
PILOT_Y_RATE_TC 0
RTL_ALT_FINAL_M 0
RTL_ALT_M 1.96
RTL_ALT_TYPE 0
RTL_CLIMB_MIN_M 0
RTL_CONE_SLOPE 3
RTL_LOIT_TIME 5000
RTL_OPTIONS 0
RTL_SPEED_MS 0
TKOFF_RPM_MAX 0
TKOFF_RPM_MIN 0
TKOFF_SLEW_TIME 2
TKOFF_THR_MAX 0.9
WP_ACC 2.5
WP_ACC_CNR 0
WP_ACC_Z 1
WP_JERK 1
WP_NAVALT_MIN 0
WP_RADIUS_M 2
WP_RFND_USE 1
WP_SPD 10
WP_SPD_DN 1.5
WP_SPD_UP 2.5
WP_TER_MARGIN 10
WP_YAW_BEHAVIOR 2
SIM_WIND_SPD 3
SIM_WIND_DIR 250
SIM_WIND_TURB 1
LOG_BACKEND_TYPE 0
SIM_BATT_VOLTAGE 16.8
