# Coybot analog-pilot training — tasks for hoopoe (A100).
# Usage (from repo root):
#   just -f eco/drone/training/justfile deploy
#   just -f eco/drone/training/justfile dataset episodes=4000
#   just -f eco/drone/training/justfile train epochs=30
#   just -f eco/drone/training/justfile pull
#   just -f eco/drone/training/justfile smoke    # run unit tests on hoopoe

hoopoe := "yusuf@hoopoe"
remote_dir := "~/coybot-training"
model_out := "~/drone-data/bc_v2/models"
local_models := "eco/drone/models"
ssh_opts := "-o PreferredAuthentications=password -o PubkeyAuthentication=no -o StrictHostKeyChecking=accept-new"
python := "/opt/ml/isaac-sim-env/bin/python3"

# Rsync the training package to hoopoe and install deps
deploy:
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "mkdir -p {{remote_dir}}/eco/drone/training/tests {{remote_dir}}/eco/drone/common ~/drone-data/bc_v2/models"
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/__init__.py eco/drone/__init__.py \
        {{hoopoe}}:{{remote_dir}}/eco/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/__init__.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/training/__init__.py \
        eco/drone/training/contract.py \
        eco/drone/training/expert.py \
        eco/drone/training/world2d.py \
        eco/drone/training/dataset.py \
        eco/drone/training/train.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/training/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/training/tests/__init__.py \
        eco/drone/training/tests/test_smoothness.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/training/tests/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/common/reactive_planner.py \
        eco/drone/common/data_recorder.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/common/
    # Ensure torch + onnx available in the Isaac venv
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "uv pip install --python {{python}} --quiet torch onnx onnxruntime pytest 2>&1 | tail -3"

# Generate the BC dataset on hoopoe
dataset eps="4000" seed="0" rfrac="0.4":
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "cd {{remote_dir}} && PYTHONPATH=. {{python}} -m eco.drone.training.dataset \
            --out ~/drone-data/bc_v2 \
            --episodes {{eps}} \
            --rover-fraction {{rfrac}} \
            --seed {{seed}}"

# Train + export on hoopoe
train epochs="30" hidden="64" version="v2":
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "cd {{remote_dir}} && PYTHONPATH=. {{python}} -m eco.drone.training.train \
            --data ~/drone-data/bc_v2/dataset.npz \
            --out {{model_out}} \
            --epochs {{epochs}} \
            --hidden {{hidden}} \
            --version {{version}}"

# Pull trained models back to local eco/drone/models/
pull version="v2":
    mkdir -p {{local_models}}
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        "{{hoopoe}}:{{model_out}}/policy_{{version}}.onnx" \
        "{{hoopoe}}:{{model_out}}/policy_{{version}}_state_norm.npy" \
        "{{hoopoe}}:{{model_out}}/policy_{{version}}_train_summary.json" \
        {{local_models}}/

# Run unit tests on hoopoe (no torch needed for most tests)
smoke:
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "cd {{remote_dir}} && PYTHONPATH=. {{python}} -m pytest eco/drone/training/tests -q"

# Deploy multi-agent training files to hoopoe
deploy-ma:
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/training/dynamics.py \
        eco/drone/training/rover_contract.py \
        eco/drone/training/train_rl_rover.py \
        eco/drone/training/train_ma_rover.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/training/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/training/tests/test_train_ma_rover.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/training/tests/
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "uv pip install --python {{python}} --quiet torch onnx onnxruntime pytest 2>&1 | tail -3"

# Train multi-agent IPPO on hoopoe (warm-start from single-agent checkpoint recommended)
train-ma iters="1200" envs="256" agents="4" version="ma_rover_v1" ckpt="":
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "cd {{remote_dir}} && PYTHONPATH=. {{python}} -m eco.drone.training.train_ma_rover \
            --out ~/drone-data/rover/models \
            --version {{version}} \
            --iters {{iters}} \
            --envs {{envs}} \
            --agents {{agents}} \
            $(if [ -n '{{ckpt}}' ]; then echo '--ckpt {{ckpt}}'; fi)"

# Pull MA rover model back locally
pull-ma version="ma_rover_v1":
    mkdir -p {{local_models}}
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        "{{hoopoe}}:~/drone-data/rover/models/policy_{{version}}.onnx" \
        "{{hoopoe}}:~/drone-data/rover/models/policy_{{version}}_state_norm.npy" \
        "{{hoopoe}}:~/drone-data/rover/models/policy_{{version}}_rl_summary.json" \
        {{local_models}}/

# Run MA scorecard comparison after pulling a trained policy
scorecard-compare version="ma_rover_v1":
    ~/code/ys/coybot/eco/drone/sim/.venv-mac/bin/python \
        ~/code/ys/coybot/eco/drone/sim/scorecard.py \
        --policy {{local_models}}/policy_{{version}}.onnx \
        --out ~/code/ys/coybot/eco/drone/sim/scorecard_{{version}}.json

# Full MA pipeline: deploy -> train -> pull -> compare
train-ma-all version="ma_rover_v1" iters="1200":
    just -f eco/drone/training/justfile deploy-ma
    just -f eco/drone/training/justfile train-ma version={{version}} iters={{iters}}
    just -f eco/drone/training/justfile pull-ma version={{version}}
    just -f eco/drone/training/justfile scorecard-compare version={{version}}

# Deploy fixed-wing (Dubins-airplane) training files to hoopoe
deploy-fw:
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "mkdir -p {{remote_dir}}/eco/drone/training/tests {{remote_dir}}/eco/drone/common ~/drone-data/fixedwing/models"
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/__init__.py eco/drone/__init__.py \
        {{hoopoe}}:{{remote_dir}}/eco/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/__init__.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/training/__init__.py \
        eco/drone/training/contract.py \
        eco/drone/training/fw_contract.py \
        eco/drone/training/dynamics.py \
        eco/drone/training/train_rl.py \
        eco/drone/training/train_rl_fixedwing.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/training/
    sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
        eco/drone/common/vehicle_class.py \
        {{hoopoe}}:{{remote_dir}}/eco/drone/common/
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "uv pip install --python {{python}} --quiet torch onnx onnxruntime pytest 2>&1 | tail -3"

# Train fixed-wing PPO on hoopoe (from scratch, no BC warm-start — see train_rl_fixedwing.py docstring)
train-fw iters="800" envs="512" version="fw_v1":
    sshpass -p "$HOOPOE_SSH_PASSWORD" ssh {{ssh_opts}} {{hoopoe}} \
        "cd {{remote_dir}} && PYTHONPATH=. {{python}} -m eco.drone.training.train_rl_fixedwing \
            --out ~/drone-data/fixedwing/models \
            --version {{version}} \
            --iters {{iters}} \
            --envs {{envs}}"

# Pull trained fixed-wing model back to local eco/drone/models/
# (looped single-file scp — sshpass + a multi-source scp in one call drops files partway through)
pull-fw version="fw_v1":
    mkdir -p {{local_models}}
    for f in policy_{{version}}.onnx policy_{{version}}_ac.pt policy_{{version}}_rl_summary.json; do \
        sshpass -p "$HOOPOE_SSH_PASSWORD" scp {{ssh_opts}} \
            "{{hoopoe}}:~/drone-data/fixedwing/models/$f" {{local_models}}/; \
    done

# Full fixed-wing pipeline: deploy -> train -> pull
train-fw-all version="fw_v1" iters="800":
    just -f eco/drone/training/justfile deploy-fw
    just -f eco/drone/training/justfile train-fw version={{version}} iters={{iters}}
    just -f eco/drone/training/justfile pull-fw version={{version}}

# Full pipeline: deploy -> dataset -> train -> pull
all episodes="4000" epochs="30":
    just -f eco/drone/training/justfile deploy
    just -f eco/drone/training/justfile dataset episodes={{episodes}}
    just -f eco/drone/training/justfile train epochs={{epochs}}
    just -f eco/drone/training/justfile pull
